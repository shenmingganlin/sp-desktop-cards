{
  "name": "sp-desktop-cards",
  "productName": "SP 桌面卡片",
  "version": "0.5.2",
  "description": "Super Productivity 的桌面卡片：专注与番茄钟、今日、规划、日程、月历、统计，卡片可拼接吸附，可置顶或嵌入桌面。",
  "main": "src/main/main.js",
  "type": "module",
  "license": "MIT",
  "author": "shenmingganlin",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "node --require ./scripts/copyfile-fallback.cjs node_modules/electron-builder/cli.js --win",
    "smoke": "node scripts/smoke.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "menu-check": "node scripts/menu-check.mjs",
    "desktop-check": "node scripts/desktop-check.mjs",
    "update-check": "node scripts/update-check.mjs",
    "icons": "python scripts/icons.py",
    "resize-check": "node scripts/resize-check.mjs",
    "theme-check": "node scripts/theme-check.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "io.github.shenmingganlin.sp-desktop-cards",
    "productName": "SP 桌面卡片",
    "executableName": "SP-Desktop-Cards",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "assets/tray@2x.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "sp-desktop-cards-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SP 桌面卡片",
      "uninstallDisplayName": "SP 桌面卡片",
      "artifactName": "sp-desktop-cards-${version}-setup.${ext}"
    },
    "asarUnpack": [
      "node_modules/@koromix/**"
    ]
  },
  "dependencies": {
    "koffi": "^3.3.6"
  }
}
